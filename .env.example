# ─── MySQL (n8n roster data) ────────────────────────────────
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password
MYSQL_DATABASE=automation_flow
MYSQL_USER=n8n_user
MYSQL_PASSWORD=n8n_password

# ─── PostgreSQL (n8n internal) ──────────────────────────────
POSTGRES_N8N_USER=n8n_user
POSTGRES_N8N_PASSWORD=n8n_password
POSTGRES_N8N_DB=n8n_db

# ─── PostgreSQL (TSG Auth) ──────────────────────────────────
TSG_AUTH_PG_USER=tsg_auth
TSG_AUTH_PG_PASSWORD=CHANGE_ME_pg_password
TSG_AUTH_PG_DB=tsg_auth

# ─── TSG Auth service ───────────────────────────────────────
TSG_AUTH_JWT_SECRET=CHANGE_ME_long_random_string
TSG_AUTH_INIT_SUPERADMIN_USERNAME=superadmin
TSG_AUTH_INIT_SUPERADMIN_PASSWORD=CHANGE_ME_superadmin_password
TSG_AUTH_INIT_SUPERADMIN_EMAIL=superadmin@tsg.local

# ─── SMTP (Gmail App Password — NOT your Gmail login password)
# Generate at: https://myaccount.google.com/apppasswords
# 2-Step Verification must be enabled first.
TSG_AUTH_SMTP_PASSWORD=CHANGE_ME_gmail_app_password

# ─── Timezone ───────────────────────────────────────────────
TZ=Asia/Calcutta
